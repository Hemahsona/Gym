@using Gym.BusinessLogic.ViewModels.MebmerShip
@model IEnumerable<IndexMemberShipViewModel>
﻿<div class="container-fluid">
    <partial name="_TempData" />
    <header class="bg-primary text-white rounded-3 p-4 shadow-sm mt-5 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1 fw-semibold">Active Memberships</h2>
                <p class="mb-0 text-light opacity-75">Members That have Active Plans</p>
            </div>
            <div class="col text-end">
                <a asp-action="Create" class="btn btn-light">
                    <i class="fas fa-plus"></i> New Membership
                </a>
            </div>
        </div>
    </header>

    <div class="card">
        <div class="card-body">
                        
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Plan</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th> 
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var membership in Model)
                    {
                        <tr>

                            <td>@membership.Name</td>
                            <td>@membership.PlanName</td>
                            <td>@membership.StartDate</td>
                            <td>@membership.EndDate</td>
                            <td>@membership.Status</td>
                            <td>


                                @* <div class="container mt-5">
                                    <div class="row justify-content-center">
                                        <div class="col-md-6">
                                            <div class="card p-5 shadow text-center">
                                                <p class="fs-3 text-primary-color mb-4">Are you sure you want to delete this member?</p>

                                                <div class="alert alert-warning text-start" role="alert">
                                                    <strong>Warning!</strong> This action cannot be undone. All member data will be permanently deleted.
                                                </div>

                                                <form asp-action="Delete" method="post" class="mt-4">
                                                    <input type="hidden" name="id" value="@ViewBag.id" />

                                                    <div class="buttons d-flex justify-content-between gap-3">
                                                        <a asp-controller="MemberShips" asp-action="Index" class="btn-outline flex-fill">NO</a>
                                                        <button type="submit" class="btn-fill flex-fill">Yes</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div> *@

                                <div class="d-flex gap-1">
                                    <a asp-action="Delete" asp-route-id="@membership.Id" class="btn btn-outline text-danger btn-sm flex-fill">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </a>
                                    @* <form method="post" asp-action="Delete" class="m-0">
                                        <input type="hidden" name="id" value="@membership.Id" /> 

                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-times"></i> Cancel
                                        </button>
                                    </form> *@
                                </div>





                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            

            @if(Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-workspace display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">No Active Memberships Available</h4>
                </div>
            }

            
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_AlertDismissScript.cshtml" />
}